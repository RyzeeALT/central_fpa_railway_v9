# Desenvolvimento local
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
FLASK_DEBUG=1

# Local: deixe vazio para usar SQLite.
# Railway: no serviço web, referencie a DATABASE_URL do serviço PostgreSQL.
DATABASE_URL=

# Primeiro admin na Railway (temporário):
# Use apenas no primeiro deploy e remova BOOTSTRAP_ADMIN_PASSWORD depois.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
